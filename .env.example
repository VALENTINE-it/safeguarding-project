# ==========================================
# Frontend Configuration (my-app)
# ==========================================
# Set this at BUILD TIME in your hosting platform (Vercel, Netlify, Render, etc.)
# Local Development: http://localhost:5000
# Production: https://<your-deployed-backend-domain> (Must use HTTPS!)
REACT_APP_API_URL=http://localhost:5000

# ==========================================
# Backend Configuration (my-app/backend-go)
# ==========================================
# Port the Go HTTP server listens on (e.g. 5000 or Render's PORT)
PORT=5000

# Path to SQLite database file.
# In production with persistent disk/volume mounted (e.g. at /var/data):
# DB_PATH=/var/data/safeguarding.db
DB_PATH=./safeguarding.db

# Secret key used for signing JWT tokens
JWT_SECRET=safeguarding_secret_key_2026
