# React App Environment Configuration
# NOTE: In Create React App, variables starting with REACT_APP_ are embedded at BUILD TIME (npm run build).
# When deploying the frontend, configure this in your hosting provider's build environment variables.

# Local development:
REACT_APP_API_URL=http://localhost:5000

# Production deployment example:
# REACT_APP_API_URL=https://api.your-safeguarding-domain.com
