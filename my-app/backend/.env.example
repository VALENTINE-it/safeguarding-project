# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/safeguarding

# MongoDB Atlas (replace with your connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/safeguarding?retryWrites=true&w=majority

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of your React front-end (used in production)
CLIENT_ORIGIN=http://localhost:3000
